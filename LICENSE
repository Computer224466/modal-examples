 
import streamlit as st
import sqlite3

# إعداد قاعدة بيانات
conn = sqlite3.connect('personal_library.db')
c = conn.cursor()
c.execute('''CREATE TABLE IF NOT EXISTS books (title TEXT, content TEXT, category TEXT)''')

private_key = "YOUR_SECRET_KEY"  # مفتاحك الخاص

def add_book(title, content, category):
    c.execute("INSERT INTO books VALUES (?, ?, ?)", (title, content, category))
    conn.commit()

key_input = st.text_input("أدخل المفتاح الخاص للإضافة:")
if key_input == private_key:
    title = st.text_input("عنوان الكتاب/المقالة:")
    content = st.text_area("المحتوى أو الرابط:")
    category = st.selectbox("التصنيف:", ["علوم إنسانية", "ميتافيزيقيا", "فلسفة", "أنثروبولوجيا", "باراسيكولوجي", "علم نفس سلوكي", "علاج بالفنون"])
    if st.button("إضافة"):
        add_book(title, content, category)
        st.success("تمت الإضافة!")
 
