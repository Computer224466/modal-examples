            showMessage('system', `تم تعيين المزاج إلى: ${config.name}`, 'ai');
            showToast(`تم تعيين حالة ${config.name}`, '🎭');
        }

        // Show message function
        function showMessage(sender, content, type) {
            const container = document.getElementById('chat-container');
            
            // Remove welcome message if it's the first real message
            if (container.children.length === 1 && container.firstElementChild.classList.contains('text-center')) {
                container.innerHTML = '';
            }
            
            // Add to chat history
            chatHistory.push({ sender, content, type });
            
            const messageDiv = document.createElement('div');
            messageDiv.className = `message-bubble flex ${sender === 'user' ? 'justify-end' : 'justify-start'}`;
            
            const messageContent = document.createElement('div');
            messageContent.className = 'max-w-[90%] md:max-w-[85%]';
            
            if (type === 'ai') {
                messageContent.innerHTML = `
                    <div class="bg-gradient-to-r from-ai-blue/10 to-ai-purple/10 text-gray-800 dark:text-gray-200 p-4 rounded-2xl border border-ai-blue/20">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 bg-gradient-to-br from-ai-blue to-ai-purple rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                                <span class="text-white text-sm">🤖</span>
                            </div>
                            <div class="flex-1">
                                <div class="prose prose-sm max-w-none dark:prose-invert">
                                    ${formatMessage(content)}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            } else if (type === 'user') {
                messageContent.innerHTML = `
                    <div class="bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-200 p-4 rounded-2xl shadow-md border border-gray-200 dark:border-gray-600">
                        <div class="flex items-start gap-3">
                            <div class="flex-1">
                                <div class="prose prose-sm max-w-none dark:prose-invert">
                                    ${formatMessage(content)}
                                </div>
                            </div>
                            <div class="w-8 h-8 bg-gradient-to-br from-gray-400 to-gray-600 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                                <span class="text-white text-sm">👤</span>
                            </div>
                        </div>
                    </div>
                `;
            } else if (type === 'system') {
                messageContent.innerHTML = `
                    <div class="max-w-xl mx-auto bg-green-50 dark:bg-green-900/30 text-green-800 dark:text-green-200 p-3 rounded-xl text-center text-sm border border-green-200 dark:border-green-700">
                        ${content}
                    </div>
                `;
            } else if (type === 'error') {
                messageContent.innerHTML = `
                    <div class="max-w-xl bg-red-50 dark:bg-red-900/30 text-red-800 dark:text-red-200 p-4 rounded-2xl border border-red-200 dark:border-red-700">
                        ${content}
                    </div>
                `;
            } else if (type === 'thinking') {
                messageContent.innerHTML = `
                    <div class="max-w-3xl bg-gradient-to-r from-ai-blue/10 to-ai-purple/10 text-gray-800 dark:text-gray-200 p-4 rounded-2xl border border-ai-blue/20">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 bg-gradient-to-br from-ai-blue to-ai-purple rounded-full flex items-center justify-center flex-shrink-0 mt-1 animate-thinking">
                                <span class="text-white text-sm">🤖</span>
                            </div>
                            <div class="flex-1">
                                <div class="prose prose-sm max-w-none dark:prose-invert" id="thinking-content">
                                    <p class="flex items-center gap-2">
                                        <span class="typing-indicator">
                                            <span class="typing-dot"></span>
                                            <span class="typing-dot"></span>
                                            <span class="typing-dot"></span>
                                        </span>
                                        أحلل سؤالك وأجمع أفكاري...
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }
            
            messageDiv.appendChild(messageContent);
            container.appendChild(messageDiv);
            container.scrollTop = container.scrollHeight;
        }

        // Format message content (preserve line breaks and lists)
        function formatMessage(content) {
            // Preserve line breaks
            let formatted = content.replace(/\n/g, '<br>');
            
            // Replace *bold* with <strong>
            formatted = formatted.replace(/\*(.*?)\*/g, '<strong>$1</strong>');
            
            // Replace _italic_ with <em>
            formatted = formatted.replace(/_(.*?)_/g, '<em>$1</em>');
            
            // Detect lists with dashes
            if (formatted.includes('- ')) {
                const listItems = formatted.split('\n').filter(line => line.startsWith('- '));
                if (listItems.length > 1) {
                    const listHtml = listItems.map(item => 
                        `<li>${item.substring(2).trim()}</li>`
                    ).join('');
                    formatted = formatted.replace(
                        listItems.join('\n'), 
                        `<ul class="list-disc pl-5">${listHtml}</ul>`
                    );
                }
            }
            
            return formatted;
        }

        // Send message function
        async function sendMessage() {
            if (isThinking) return;
            
            const input = document.getElementById('user-input');
            const message = input.value.trim();
            
            if (!message) {
                showToast('يرجى كتابة سؤال أو موضوع للمناقشة', '⚠️');
                return;
            }
            
            if (!currentMood) {
                showToast('يرجى اختيار حالتك المزاجية أولاً', '🎭');
                return;
            }
            
            // Show user message
            showMessage('user', message, 'user');
            input.value = '';
            updateCharCount();
            
            // Show thinking state
            isThinking = true;
            updateSendButton();
            showMessage('ai', '', 'thinking');
            
            // Prepare AI prompt
            const config = moodConfigs[currentMood];
            const aiPrompt = `${config.prompt}\n\nسؤال المستخدم: ${message}`;
            
            try {
                // Simulate API call with timeout
                setTimeout(() => {
                    // Get the thinking message element
                    const thinkingContent = document.querySelector('#thinking-content');
                    if (thinkingContent) {
                        // Replace with actual response
                        thinkingContent.innerHTML = `
                            <p>أهلاً بك! بناءً على حالتك المزاجية (${config.name})، سأقدم لك الإجابة الأنسب:</p>
                            <p class="mt-3">${generateSampleResponse(message, currentMood)}</p>
                            <div class="mt-4 bg-blue-50 dark:bg-blue-900/30 p-3 rounded-lg text-sm">
                                <p>💡 نصيحة: هذه إجابة تجريبية. في التطبيق الحقيقي، سيتم التواصل مع نموذج الذكاء الاصطناعي.</p>
                            </div>
                        `;
                    }
                    
                    // Update chat history
                    chatHistory[chatHistory.length - 1].content = thinkingContent.innerHTML;
                    chatHistory[chatHistory.length - 1].type = 'ai';
                    
                    isThinking = false;
                    updateSendButton();
                }, 3000);
            } catch (error) {
                showMessage('ai', 'عذراً، لم أتمكن من الاتصال بشريكي في الذكاء الاصطناعي. يرجى المحاولة مرة أخرى.', 'error');
                isThinking = false;
                updateSendButton();
            }
        }

        // Generate sample responses for demo
