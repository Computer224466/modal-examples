        });

        // Set mood function
        function setMood(mood) {
            currentMood = mood;
            const config = moodConfigs[mood];
            
            // Update mood display
            document.getElementById('current-mood').textContent = config.name;
            document.getElementById('mood-description').textContent = config.description;
            
            // Update background
            const bg = document.getElementById('dynamic-bg');
            bg.className = `fixed inset-0 bg-gradient-to-br ${config.colors.join(' ')} ${config.darkColors.join(' ')} bg-size-200 animate-gradient-shift transition-all duration-1000`;
            
