        // Update send button state
        function updateSendButton() {
            const sendBtn = document.getElementById('send-btn');
            if (isThinking) {
                sendBtn.disabled = true;
                sendBtn.innerHTML = '<span>جاري المعالجة</span> <span class="typing-indicator"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></span>';
            } else {
                sendBtn.disabled = false;
                sendBtn.innerHTML = '<span>إرسال</span> <span>🚀</span>';
            }
        }

        // Clear chat
        function clearChat() {
            const container = document.getElementById('chat-container');
            container.innerHTML = `
                <div class="text-center text-gray-500 dark:text-gray-400 py-8">
                    <div class="animate-pulse-slow">
                        <div class="w-16 h-16 mx-auto mb-4 bg-gradient-to-br from-ai-blue to-ai-purple rounded-full flex items-center justify-center">
                            <span class="text-white text-2xl">🤖</span>
                        </div>
                        <p class="text-lg">مرحباً، أنا شريكك في الذكاء الاصطناعي</p>
                        <p class="text-sm mt-2">اكتب سؤالك أو موضوعك وسأقدم لك تحليلاً عميقاً ونصائح مفيدة</p>
                    </div>
                </div>
            `;
            
            chatHistory = [];
            currentMood = null;
            document.getElementById('current-mood').textContent = 'غير محددة';
            document.getElementById('mood-description').textContent = 'اختر حالتك المزاجية لبدء تجربة مخصصة';
            document.querySelectorAll('.mood-btn').forEach(btn => {
                btn.classList.remove('bg-opacity-100', 'text-white');
            });
            
            showToast('تم مسح المحادثة', '🧹');
        }

        // Save chat to localStorage
        function saveChat() {
            if (chatHistory.length === 0) {
                showToast('لا توجد محادثة لحفظها', 'ℹ️');
                return;
            }
            
            const chatData = {
                history: chatHistory,
                mood: currentMood,
                timestamp: new Date().toISOString()
            };
            
            localStorage.setItem('ai_chat_saved', JSON.stringify(chatData));
            showToast('تم حفظ المحادثة بنجاح', '💾');
        }

        // Load chat from localStorage
        function loadChat() {
            const savedChat = localStorage.getItem('ai_chat_saved');
            if (!savedChat) {
                showToast('لا توجد محادثة محفوظة', 'ℹ️');
                return;
            }
            
            try {
                const chatData = JSON.parse(savedChat);
                clearChat();
                
                // Set mood
                if (chatData.mood) {
                    setMood(chatData.mood);
                }
                
                // Restore messages
                const container = document.getElementById('chat-container');
                container.innerHTML = '';
                
                chatData.history.forEach(msg => {
                    showMessage(msg.sender, msg.content, msg.type);
                });
                
                showToast('تم تحميل المحادثة بنجاح', '📂');
            } catch (e) {
                showToast('حدث خطأ في تحميل المحادثة', '❌');
            }
        }

        // Load example conversation
        function loadExample(num) {
            clearChat();
            
            const examples = [
                {
                    mood: 'wisdom',
                    question: 'كيف أطور مهاراتي القيادية؟',
                    response: 'تطوير المهارات القيادية رحلة متعددة الأبعاد. إليك أهم النقاط:<br><br><ul class="list-disc pl-5"><li>ابدأ بفهم نفسك: نقاط قوتك وضعفك</li><li>تعلم من القادة الملهمين</li><li>طور مهارات التواصل الفعال</li><li>كن قدوة في الأخلاق والتفاني</li><li>تقبل المسؤولية واتخذ القرارات</li></ul><br>القيادة ليست منصباً بل سلوكاً وممارسة يومية.'
                },
                {
                    mood: 'creative',
                    question: 'أحتاج أفكاراً لرواية خيالية',
                    response: 'فكرة رواية ممتازة! كيف عن هذه الفكرة:<br><br><strong>عالم الألوان الناطقة:</strong><br>في عالم حيث الألوان تتحدث وتؤثر على المشاعر، يكتشف البطل أنه الوحيد الذي يرى الألوان دون سماعها. عندما تبدأ الألوان بالاختفاء واحداً تلو الآخر، يجب أن يعرف السبب قبل أن يفقد العالم ألوانه إلى الأبد.<br><br>الرمزية: تمثل الألوان جوانب المشاعر الإنسانية، والاختفاء يمثل خسارة الإنسان لطبيعته في العالم الحديث.'
                },
                {
                    mood: 'tranquil',
                    question: 'كيف أتخلص من التوتر؟',
                    response: 'للتخلص من التوتر، جرب هذه النصائح العملية:<br><br>1. خصص 5 دقائق يومياً للتنفس العميق والتركيز على الحاضر<br>2. اكتب ما يقلقك على ورقة ثم مزقها رمزياً<br>3. مارس المشي في الطبيعة دون هاتف<br>4. استمع إلى أصوات الطبيعة أو موسيقى هادئة<br>5. تقبل أن بعض الأمور خارجة عن سيطرتك<br><br>تذكر أن التوتر زائر مؤقت، لا تجعله مقيمًا دائمًا في عقلك.'
                }
            ];
            
            const ex = examples[num - 1];
            setMood(ex.mood);
            showMessage('user', ex.question, 'user');
            
            setTimeout(() => {
                showMessage('ai', ex.response, 'ai');
            }, 1000);
        }
    </script>
</body>
</html>
 
import streamlit as st
import spotipy  # مكتبة لـ Spotify API
from spotipy.oauth2 import SpotifyClientCredentials

# إعداد API (استبدل بمعلوماتك)
sp = spotipy.Spotify(auth_manager=SpotifyClientCredentials(client_id="YOUR_CLIENT_ID", client_secret="YOUR_CLIENT_SECRET"))

def play_music(query, mood):
    results = sp.search(q=query + " " + mood, type='track')
    track = results['tracks']['items'][0]
    st.audio(track['preview_url'])  # تشغيل معاينة

# في الواجهة
mood = st.selectbox("اختر حالة: ", ["راحة واسترخاء", "حماس ونشاط"])
query = st.text_input("ابحث عن موسيقى:")
if st.button("تشغيل"):
    play_music(query, mood)
 
 
import streamlit as st
from transformers import pipeline  # لتحليل المزاج

sentiment = pipeline('sentiment-analysis')

def auto_music(user_input):
    analysis = sentiment(user_input)[0]
    if analysis['label'] == 'NEGATIVE':  # تعب أو حزن
        return "relaxing_music_url"  # رابط موسيقى هادئة
    else:
        return "energetic_music_url"  # رابط موسيقى نشيطة

user_input = st.text_input("اكتب شيئًا:")
music_url = auto_music(user_input)
if st.checkbox("تشغيل موسيقى خلفية تلقائية"):
    st.audio(music_url, format='audio/mp3')
# للتفاعل مع الألوان: st.markdown("<style>body {background-color: lightblue;}</style>", unsafe_allow_html=True)  # تغيير حسب الموسيقى


